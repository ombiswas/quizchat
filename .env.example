# ── MongoDB ───────────────────────────────────────────────────────────────────
# Full connection URI. When running via docker-compose, use the service name as host.
MONGO_URI=mongodb://mongo:27017
# For local development outside docker, use:
# MONGO_URI=mongodb://localhost:27017

MONGO_DB_NAME=quizchat

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_before_running

# JWT expiry in minutes (default: 1 day = 1440)
JWT_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origin that the backend will allow. Should match your frontend URL.
FRONTEND_ORIGIN=http://localhost:5173

# ── Frontend ──────────────────────────────────────────────────────────────────
# Base URL the React app uses to reach the API.
VITE_API_URL=http://localhost:8000

# ── Seed configuration ────────────────────────────────────────────────────────
# These values control how much dummy data seed_data.py inserts.
SEED_NUM_USERS=50
SEED_NUM_EXAMS=3
SEED_NUM_SUBJECTS=10
SEED_NUM_CHAPTERS=30
SEED_NUM_QUESTIONS=500
SEED_QUESTIONS_PER_QUIZ=15
